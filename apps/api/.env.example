# Copy to .env for local development. Production reads the real environment (and refuses unsafe values).
APP_ENV=development
DEMO_MODE=true
LOG_JSON=false
# Runtime role (non-owner, subject to row-level security) and the schema owner for migrations.
DATABASE_URL=postgresql+asyncpg://ci_app:ci_app@localhost:5432/command_inbox
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/command_inbox
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173
# Keycloak (docker compose --profile sso): realm "command-inbox", client "command-inbox".
# OIDC_ISSUER=http://localhost:8081/realms/command-inbox
# OIDC_CLIENT_SECRET=
# Models: Claude for System 2; the decision engine for System 1 (heuristic, llamacpp or vllm).
# ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
DECISION_ENGINE=auto
# DECISION_ENGINE_URL=http://localhost:8090
# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LANGFUSE_PUBLIC_KEY= / LANGFUSE_SECRET_KEY= / LANGFUSE_HOST=http://localhost:3000
ENCRYPTION_KEY=dev-only-key-change-me-dev-only-key-change-me
INTAKE_WEBHOOK_SECRET=dev-intake-secret
# Knowledge: embeddings (hash is development-only), optional reranker, ClamAV for uploads
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_URL=http://localhost:8091
# EMBEDDING_MODEL=bge-m3
# RERANK_URL=http://localhost:8092
# CLAMAV_HOST=localhost
