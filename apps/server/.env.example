# Runtime role (non-owner, subject to row-level security)
DATABASE_URL=postgres://ci_app:ci_app@localhost:5432/command_inbox
# Owner role for migrations and seed
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/command_inbox
WEB_ORIGIN=http://localhost:5173
DEMO_MODE=true
# Set to use Claude for triage, drafting and the copilot. Without it the deterministic heuristic provider runs.
# ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
ENCRYPTION_KEY=dev-only-key-change-me-dev-only-key-change-me
INTAKE_WEBHOOK_SECRET=dev-intake-secret
