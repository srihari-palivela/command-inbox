{
  "name": "command-inbox",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @ci/server db:migrate",
    "db:seed": "pnpm --filter @ci/server db:seed",
    "db:reset": "pnpm --filter @ci/server db:reset",
    "e2e": "pnpm --filter @ci/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "prettier": "^3.8.1"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
