{
  "name": "command-inbox",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ci/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @ci/web e2e",
    "test:unit": "pnpm --filter @ci/web test",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/web/e2e/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/web/e2e/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "db:reset": "cd apps/api && uv run command-inbox-seed --demo --reset",
    "db:seed": "cd apps/api && uv run command-inbox-seed --demo --if-empty",
    "test:api": "cd apps/api && uv run pytest -q",
    "dev:api": "cd apps/api && uv run uvicorn command_inbox.main:create_app --factory --reload --reload-dir src --port 4000"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
