{
  "name": "command-inbox",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @ci/server db:migrate",
    "db:seed": "pnpm --filter @ci/server db:seed",
    "db:reset": "pnpm --filter @ci/server db:reset",
    "e2e": "pnpm --filter @ci/web e2e",
    "test:unit": "pnpm --filter @ci/web test && pnpm --filter @ci/server test:unit",
    "test:integration": "pnpm --filter @ci/server test:integration",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/web/e2e/**/*.ts\" \"apps/server/test/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/web/e2e/**/*.ts\" \"apps/server/test/**/*.ts\" \"packages/*/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
